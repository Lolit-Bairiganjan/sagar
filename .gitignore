# =========================================
# TrackTrace (SIH26143) — Monorepo .gitignore
# ai-model/ (Python) + backend/ (Python) + frontend/ (Node/React)
# =========================================

# ---------- Python (ai-model, backend) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
*.egg-info/
.eggs/
pip-log.txt
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------- Environment variables / secrets ----------
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
ai-model/.env

# ---------- AI/ML specific (ai-model/) ----------
# Model weights & checkpoints (too large for git — use shared Drive link)
*.pt
*.pth
*.h5
*.onnx
*.weights
runs/
wandb/
checkpoints/

# Raw satellite imagery / large datasets (never commit rasters)
*.tif
*.tiff
*.jp2
*.SAFE/
*.npy
ai-model/data/

# Training outputs (can be GBs — regenerate from weights)
ai-model/outputs/

# Dev 1 generated tiles (regenerated from pipeline)
dev1_pipeline/tiles/

# Jupyter notebook artifacts
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ai-model virtual environment
ai-model/.venv/
ai-model/venv/

# Keep clean output GeoJSON if small & needed for demo — otherwise ignore large ones
# *.geojson

# ---------- Node / React (frontend) ----------
frontend/node_modules/
dist/
build/
.vite/
.turbo/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Editor / OS ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------- Deployment ----------
.vercel/
.render/

# ---------- Logs ----------
*.log
logs/
# Environment variables (contains real secrets)
.env
backend/.env

# Python
venv/
__pycache__/
*.pyc
backend/venv/

# Node / frontend
node_modules/
frontend/node_modules/
frontend/dist/

# Editor/OS junk
.vscode/
.DS_Store
