# MAP TOKENS (all optional)
# The app works without either token using a token-free OpenStreetMap fallback.
# For CARTO Dark Matter, request a free CARTO basemap key and paste it here.
VITE_CARTO_BASEMAP_KEY=
# Optional Mapbox PUBLIC token (starts with pk.). Never put an sk. token here.
VITE_MAPBOX_TOKEN=

# BACKEND API
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK=true
